# Postgres connection string. Neon: Project → Connection details → "Pooled connection".
# Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Google AI Studio key (https://aistudio.google.com/apikey). Used for OCR, extraction,
# summaries and translation. Never sent to the browser.
GEMINI_API_KEY=""

# Optional. Gemini model id; defaults to gemini-3.5-flash.
GEMINI_MODEL="gemini-3.5-flash"

# Random secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to the daily cleanup.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Random salt for hashing IPs in rate-limit keys, so raw IPs are never stored. Generate as above.
IP_HASH_SALT=""

# Comma-separated emails that can open /admin (anonymous usage counts only).
ADMIN_EMAILS=""
